<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="akrem_timbre_fiscal_amount_param" model="ir.config_parameter">
        <field name="key">akrem_timbre_fiscal.amount</field>
        <field name="value">1.000</field>
    </record>
    <record id="akrem_timbre_fiscal_on_customer_invoice_param" model="ir.config_parameter">
        <field name="key">akrem_timbre_fiscal.on_customer_invoice</field>
        <field name="value">True</field>
    </record>
    <record id="akrem_timbre_fiscal_on_vendor_bill_param" model="ir.config_parameter">
        <field name="key">akrem_timbre_fiscal.on_vendor_bill</field>
        <field name="value">False</field>
    </record>

    <record id="akrem_timbre_fiscal_product_template" model="product.template">
        <field name="name">Timbre Fiscal</field>
        <field name="default_code">AKREM_TF</field>
        <field name="type">service</field>
        <field name="list_price">1.0</field>
        <field name="sale_ok">True</field>
        <field name="purchase_ok">False</field>
        <field name="taxes_id" eval="[(6, 0, [])]"/>
    </record>
</odoo>
